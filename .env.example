# ─────────────────────────────────────────────────────────
# HyLab environment variables
# Copy to `.env.local` and fill in real values.
# ─────────────────────────────────────────────────────────

# Persistent uptime history — Postgres (Supabase).
# User format for the shared pooler: [ROLE].[PROJECT-REF]
# Host/port: aws-[INDEX]-[REGION].pooler.supabase.com:6543 (transaction mode)
DATABASE_URL=postgresql://hylab_status.PROJECT_REF:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Secret for /api/cron/probe — required in production so nobody else
# can trigger probes. Sent as `?secret=...` or `Authorization: Bearer ...`
# CRON_SECRET=
